# dependencies
node_modules/

# build artifacts
*.tgz

# editor / IDE
.DS_Store
.history/
.cursor/plans/
.cursor/skills/
.idea

# agent worktrees
.claude/worktrees/

# local docs — decision records, agent configuration and the published documentation are
# versioned; qa reports, reviews and specs are scratch
docs/*
!docs/adr/
!docs/agents/
!docs/skills/
!docs/commands/
!docs/assets/
!docs/development-process.md
!docs/development-process.it.md
!docs/termbase.md

# MCP server declaration — configuration for a repository that USES this plugin, and an artifact
# in the one that builds it: a .mcp.json at the plugin root is installed with the plugin and
# registered as `plugin:jira-skills:atlassian`, an id no skill declares and none can reach. Keep
# your own locally; /jira-doctor prints the file to write.
.mcp.json

# jira project profile — versioned in a repository that USES this plugin, scratch in the one
# that builds it: what discovery writes here describes a test sandbox, not this project's work
.jira/

# logs
npm-debug.log*
